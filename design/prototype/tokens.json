{
  "$description": "Aura 工作台改版设计 Token（来源：design/prototype 原型截图）。hover/active/border 为派生建议值。",
  "color": {
    "primary": { "value": "#2266D1", "description": "主色：主按钮、选中态、链接" },
    "primaryHover": { "value": "#1B54AF", "derived": true },
    "primaryActive": { "value": "#17479A", "derived": true },
    "primaryBg": { "value": "#EEF6FF", "description": "主色浅底：选中导航、信息胶囊" },
    "primaryBorder": { "value": "#CFE2FF", "derived": true },
    "success": { "value": "#2F7D5C", "description": "进行中 / 成功" },
