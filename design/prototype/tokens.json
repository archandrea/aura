      "archived": { "label": "已归档", "fg": "#6B7785", "bg": "#F1F3F5" }
    },
    "session": {
      "streaming": { "label": "流式中", "fg": "#2266D1", "bg": "#EEF6FF" },
      "settled": { "label": "已沉淀", "fg": "#2F7D5C", "bg": "#E8F3EE" },
      "aborted": { "label": "已中断", "fg": "#C0392B", "bg": "#FBE9E9" }
    }
