    "btnHmd": { "value": 36 },
    "rowH": { "value": 44, "description": "表格表头行高" },
    "rowHLg": { "value": 60, "description": "用户表行高" }
  },
  "layout": {
    "railW": { "value": 72, "description": "方案 A 模块导航宽" },
    "sidebarW": { "value": 260, "description": "方案 A 项目侧栏宽" },
    "leftW": { "value": 280, "description": "方案 B 左栏宽" },
    "rightW": { "value": 320, "description": "方案 B 右栏（上下文沉淀）宽" },
    "rightWSm": { "value": 300, "description": "方案 B 右栏（笔记属性）宽" },
    "pagePad": { "value": 28 }
  },
  "font": {
    "family": {
      "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif"
    },
    "size": {
      "title": { "value": 22 },
      "section": { "value": 15 },
      "body": { "value": 13 },
