    "surfaceDisabled": { "value": "#F1F3F5" },
    "skeleton": { "value": "#E6EBF0" },
    "line": { "value": "#DCE3EA", "description": "常规描边、分割线" },
    "lineStrong": { "value": "#C6CFD8" },
    "rail": { "value": "#18222D", "description": "方案 A 深色模块导航底" }
  },
  "radius": {
    "sm": { "value": 6 },
    "md": { "value": 8 },
    "lg": { "value": 10 },
    "xl": { "value": 12 }
  },
  "size": {
